@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap');
:root{--bg:#f5f7fb;--panel:#fff;--text:#192338;--muted:#778198;--line:#e6eaf1;--blue:#5268e8;--blue2:#eef0ff;--green:#188b67;--greenbg:#e9f8f1;--orange:#b96a22;--orangebg:#fff4e7;--purple:#8b5bd5;--shadow:0 5px 22px rgba(26,39,74,.045)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px}.app-shell{display:flex;min-height:100vh}.sidebar{width:238px;flex-shrink:0;background:#171e32;color:#fff;padding:25px 15px;display:flex;flex-direction:column;min-height:100vh}.brand{display:flex;align-items:center;gap:11px;padding:0 9px 37px}.brand-mark{width:39px;height:39px;border-radius:12px;background:linear-gradient(135deg,#7183ff,#8b5bd5);display:grid;place-items:center;font-weight:700;letter-spacing:-1px}.brand strong{display:block;font-size:17px;letter-spacing:-.4px}.brand small{display:block;color:#a3abc0;font-size:11px;margin-top:3px}.side-label{color:#727e9c;font-size:10px;font-weight:700;letter-spacing:1.4px;padding:0 12px 10px}.nav{width:100%;border:0;background:transparent;color:#aeb7ce;text-align:left;padding:12px;border-radius:9px;display:flex;gap:12px;align-items:center;font:inherit;margin-bottom:5px;cursor:pointer}.nav span{font-weight:500}.nav.active,.nav:hover{background:#2a3452;color:#fff}.sidebar-bottom{margin-top:auto;border-top:1px solid #2b3450;padding:18px 7px 0;display:flex;align-items:center;gap:8px;color:#aab4ca;font-size:11px}.sidebar-bottom small{margin-left:auto;color:#76839e}.status-dot,.pill i{width:7px;height:7px;border-radius:50%;background:#43d4a1;display:inline-block}.main{flex:1;min-width:0;padding:29px 34px 20px;max-width:1700px;margin:0 auto}.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:23px}.eyebrow{font-size:10px;color:var(--blue);font-weight:700;letter-spacing:1.4px;margin-bottom:7px}.topbar h1{font-size:27px;letter-spacing:-.9px;margin:0}.top-actions{display:flex;align-items:center;gap:10px}.pill{display:flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--line);padding:9px 12px;border-radius:30px;font-size:11px;color:#58637a}.btn{border:0;border-radius:8px;padding:10px 14px;font:600 12px 'DM Sans',sans-serif;cursor:pointer;transition:.15s}.btn:hover{transform:translateY(-1px);filter:brightness(.98)}.btn-primary{background:var(--blue);color:white;box-shadow:0 4px 10px #5268e82a}.btn-secondary{background:#f0f2f8;color:#4f5b73;border:1px solid #e6e9f2}.btn-ghost{background:transparent;color:#68738b;border:1px solid var(--line)}.text-btn{background:transparent;border:0;color:var(--blue);font:600 12px inherit;cursor:pointer}.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:20px}.stat-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:17px 19px;box-shadow:var(--shadow)}.stat-card span{display:block;font-size:11px;color:#778198;font-weight:600}.stat-card strong{display:block;font-size:26px;letter-spacing:-.7px;margin:9px 0 4px}.stat-card small{color:#9aa3b4;font-size:10px}.workspace-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(260px,.8fr);gap:17px;margin-bottom:17px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);margin-bottom:17px;overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;padding:17px 19px;border-bottom:1px solid #edf0f5;gap:12px}.panel-head>div:first-child{min-width:0}.panel-head strong{font-size:13px}.panel-head small{display:block;color:#929bad;font-size:10px;margin-top:5px}.step-chip{display:inline-grid;place-items:center;width:25px;height:25px;background:var(--blue2);color:var(--blue);border-radius:7px;font-size:10px;font-weight:700;margin-right:9px}.step-chip.purple{background:#f3edff;color:var(--purple)}.step-chip.green{background:var(--greenbg);color:var(--green)}.step-chip.orange{background:var(--orangebg);color:var(--orange)}.editor-toolbar{height:38px;background:#fafbfe;border-bottom:1px solid #edf0f5;display:flex;align-items:center;padding:0 15px;gap:10px;color:#9aa3b4;font-size:10px}.language-tag{background:#e9edff;color:#586ce1;padding:4px 7px;border-radius:4px;font-weight:700}.toolbar-spacer{flex:1}.icon-btn{background:transparent;border:0;color:#66738b;font:500 10px inherit;cursor:pointer}textarea{font-family:'DM Mono',monospace;resize:vertical}.editor-panel textarea{display:block;width:100%;min-height:200px;height:224px;border:0;outline:0;padding:18px 19px;color:#d7def7;background:#1d2539;font-size:12px;line-height:1.85;tab-size:2;resize:vertical}.editor-footer{background:#1d2539;color:#8490ad;padding:8px 18px;display:flex;justify-content:space-between;font-size:10px;border-top:1px solid #2b344a}.button-row{display:flex;gap:8px;flex-wrap:wrap;padding:14px 16px}.quick-examples{border-top:1px solid #edf0f5;padding:12px 15px;display:flex;gap:7px;align-items:center;flex-wrap:wrap;color:#9aa3b4;font-size:10px}.quick-examples button{border:1px solid #e8ebf3;background:#fff;color:#6a7590;border-radius:5px;padding:6px 8px;font-size:10px;cursor:pointer}.schema-panel{min-width:0}.tiny-badge{background:#f2f4f8;color:#778198;padding:5px 8px;border-radius:5px;font-size:10px}.schema-list{padding:10px 14px}.schema-table{border:1px solid #edf0f5;border-radius:8px;margin:5px 0 10px;overflow:hidden}.schema-table-head{padding:10px;background:#fafbfe;display:flex;justify-content:space-between;font-size:11px;font-weight:700}.schema-table-head span{color:#9aa3b4;font-size:9px;font-weight:500}.schema-col{display:flex;align-items:center;gap:8px;padding:7px 10px;border-top:1px solid #f0f2f6;font:10px 'DM Mono',monospace;color:#65718a}.schema-col em{font-style:normal;font-size:9px;color:#a2aabc;margin-left:auto}.key-icon{color:#d39b35}.schema-note{display:flex;gap:9px;margin:8px 14px 15px;padding:11px;background:#f6f7ff;border-radius:8px;color:#6572d2;font-size:11px}.schema-note p{color:#8a92a8;font-size:10px;line-height:1.5;margin:5px 0 0}.results-panel{margin-bottom:17px}.result-heading{border-bottom:1px solid #edf0f5}.result-meta{font-size:10px;color:#7f8aa0;display:flex;gap:9px}.results-area{min-height:140px;overflow:auto}.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#9aa3b4;padding:27px}.empty-state strong{color:#68738a;font-size:12px;margin-top:10px}.empty-state p{font-size:11px;margin:6px 0}.empty-icon{width:37px;height:37px;border:1px solid #e8ebf3;background:#fafbfe;border-radius:10px;display:grid;place-items:center;color:#9ca7c0;font-size:19px}.data-table{border-collapse:collapse;width:100%;font-size:11px;white-space:nowrap}.data-table th{text-align:left;color:#707b92;background:#fafbfe;font-weight:700;padding:11px 15px;border-bottom:1px solid #e9edf4}.data-table td{padding:10px 15px;border-bottom:1px solid #f0f2f6;color:#4e5b73}.data-table tr:last-child td{border-bottom:0}.success-banner,.error-banner{margin:14px;padding:11px 13px;border-radius:7px;font-size:11px}.success-banner{background:#edf9f3;color:#208261}.error-banner{background:#fff0ef;color:#bd4f4f}.trace-panel{padding-bottom:13px}.novelty-tag{font-size:9px;color:#a36b28;background:#fff4e7;border-radius:5px;padding:6px 8px;white-space:nowrap}.trace-actions{display:flex;gap:8px;padding:14px 17px 0;flex-wrap:wrap}.trace-grid{padding:13px 17px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.trace-card{border:1px solid #e9edf4;border-radius:9px;padding:12px;min-width:0}.trace-card h4{margin:0 0 8px;font-size:11px}.trace-card p{font-size:11px;line-height:1.6;color:#68758b;margin:0;overflow-wrap:anywhere}.trace-card code{font:10px 'DM Mono',monospace;color:#b25e25;overflow-wrap:anywhere}.trace-placeholder{grid-column:1/-1;background:#fafbfe;border:1px dashed #e0e5ef;padding:18px;text-align:center;border-radius:8px;color:#929bad;font-size:11px}.compiler-stages{display:flex;align-items:center;justify-content:space-around;gap:8px;padding:20px;border-bottom:1px solid #edf0f5}.stage{display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center}.stage span{display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:#edf0ff;color:var(--blue);font-weight:700}.stage strong{font-size:11px}.stage small{font-size:9px;color:#9aa3b4}.compiler-stages>b{color:#b4bdce}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:5px 19px}.panel h3{font-size:12px;margin:18px 19px 10px}.two-col h3{margin:14px 0 9px}.code-output{margin:0;background:#1d2539;color:#d5def6;border-radius:8px;padding:13px;min-height:120px;max-height:320px;overflow:auto;font:10px/1.7 'DM Mono',monospace;white-space:pre-wrap;overflow-wrap:anywhere}.token-table{width:100%;border-collapse:collapse}.token-table th,.token-table td{padding:7px 5px;text-align:left;border-bottom:1px solid #323b51}.token-table th{color:#8d9bb9}.token-table td{color:#d4ddf3}.token-type{color:#95a5ff!important}.diagnostics{padding:14px 19px 20px;color:#768198;font-size:11px}.diagnostic-item{padding:10px;background:#fff4e8;color:#9b622c;border-radius:7px;margin:5px 0}.disclaimer{margin:0 19px 18px;color:#9aa3b4;font-size:10px;line-height:1.5}.hidden{display:none!important}.challenge-list{padding:15px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.challenge-card{border:1px solid #e5e9f2;border-radius:9px;padding:14px;cursor:pointer}.challenge-card.selected{border-color:#7785ed;background:#f8f8ff}.challenge-card strong{font-size:12px;display:block;margin:8px 0}.challenge-card p{color:#8490a5;font-size:10px;line-height:1.5}.difficulty{font-size:9px;color:#6b75d7;background:#f0f1ff;border-radius:4px;padding:4px 6px}.challenge-work{border-top:1px solid #edf0f5;padding:5px 19px 18px}.challenge-work p{color:#7f8aa0;font-size:11px}.challenge-work textarea{width:100%;min-height:115px;background:#1d2539;color:#d7def7;border:0;border-radius:8px;padding:14px;font-size:11px;line-height:1.7}.challenge-work .button-row{padding:10px 0}.feedback{padding:11px;border-radius:7px;font-size:11px;margin-top:6px}.feedback.good{background:#eaf8f1;color:#208261}.feedback.bad{background:#fff1ee;color:#b95353}.history-list{padding:10px 18px 18px}.history-item{display:flex;gap:12px;align-items:center;border-bottom:1px solid #eff1f6;padding:12px 0}.history-item:last-child{border-bottom:0}.history-query{flex:1;min-width:0}.history-query code{display:block;font:11px 'DM Mono',monospace;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;color:#4b5872}.history-query small{display:block;margin-top:6px;color:#9aa3b4;font-size:10px}.status-pill{padding:5px 7px;border-radius:5px;font-size:9px}.status-pill.success{background:#eaf8f1;color:#218562}.status-pill.error{background:#fff0ef;color:#b95353}.load-btn{border:1px solid #e6eaf2;background:white;border-radius:6px;padding:6px 8px;color:#69758e;font-size:10px;cursor:pointer}footer{display:flex;justify-content:space-between;color:#a2aabc;font-size:10px;padding:2px 3px 8px}.toast{position:fixed;bottom:20px;right:22px;background:#202941;color:white;padding:12px 16px;border-radius:8px;font-size:12px;box-shadow:0 8px 30px #16203b30;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none;max-width:360px}.toast.show{opacity:1;transform:translateY(0)}.loading{padding:15px;color:#9aa3b4;font-size:11px}@media(max-width:1050px){.sidebar{width:195px}.main{padding:22px 20px}.workspace-grid{grid-template-columns:1fr}.schema-list{display:grid;grid-template-columns:1fr 1fr;gap:8px}.schema-table{margin:0}.schema-note{grid-column:1/-1}.trace-grid{grid-template-columns:1fr 1fr}}@media(max-width:720px){.sidebar{width:62px;padding:18px 8px}.brand{padding:0 3px 28px}.brand>div:last-child,.side-label,.nav span,.sidebar-bottom span,.sidebar-bottom small{display:none}.nav{justify-content:center;padding:13px 5px}.sidebar-bottom{justify-content:center}.main{padding:18px 12px}.topbar{align-items:flex-start;gap:10px}.topbar h1{font-size:22px}.top-actions .pill{display:none}.stats-grid{grid-template-columns:1fr 1fr;gap:8px}.stat-card{padding:12px}.stat-card strong{font-size:22px}.trace-grid,.two-col,.challenge-list{grid-template-columns:1fr}.compiler-stages{flex-wrap:wrap}.compiler-stages>b{display:none}.panel-head{padding:13px}.novelty-tag{display:none}footer{gap:8px;flex-direction:column}}

/* User-created tables and rows */
.custom-data-panel{margin-bottom:17px}.custom-data-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:18px}.data-form{display:flex;flex-direction:column;gap:9px;min-width:0}.data-form h3{margin:0 0 4px;font-size:13px}.data-form label{font-size:11px;font-weight:700;color:#69758e}.data-form input,.data-form select,.data-form textarea{width:100%;border:1px solid #e1e6f0;border-radius:7px;padding:10px 11px;background:#fff;color:#364158;font:11px 'DM Mono',monospace;box-sizing:border-box}.data-form textarea{resize:vertical;line-height:1.6}.data-form small{font-size:10px;color:#8a94a8;line-height:1.5}.data-form .btn{align-self:flex-start;margin-top:3px}.custom-data-note{margin:0 18px 12px;padding:11px 13px;border-radius:7px;background:#f6f7ff;color:#69758e;font-size:11px;line-height:1.7}.custom-data-note code{font-family:'DM Mono',monospace;color:#5868c9}.custom-data-feedback{padding:0 18px 14px;font-size:11px}.custom-data-feedback:empty{display:none}.custom-data-feedback .feedback{margin:0}.schema-empty{padding:14px;color:#929bad;font-size:11px}@media(max-width:720px){.custom-data-grid{grid-template-columns:1fr;padding:14px}}




.ast-tree {
  overflow: auto;
  min-height: 180px;
  padding: 20px;
  background: #f8fafc;
  border: 1px solid #dbe3ef;
  border-radius: 10px;
  color: #172554;
}

.ast-tree ul {
  list-style: none;
  padding-left: 28px;
  margin: 8px 0;
}

.ast-tree li {
  position: relative;
  padding: 6px 0;
  border-left: 2px solid #cbd5e1;
}

.ast-node {
  display: inline-block;
  margin-left: 12px;
  padding: 8px 12px;
  border: 1px solid #93c5fd;
  border-radius: 8px;
  background: #dbeafe;
  font-family: monospace;
}

.ast-node.root {
  background: #ede9fe;
  border-color: #a78bfa;
}

.ast-node.leaf {
  background: #dcfce7;
  border-color: #86efac;
}


/* Professional AST visualization */
#ast-area.ast-tree {
  box-sizing: border-box;
  width: 100%;
  min-height: 300px;
  max-height: 620px;
  overflow: auto;
  padding: 28px 20px;
  background: #f8fafc;
  border: 1px solid #dbe3ef;
  border-radius: 12px;
  color: #172554;
  font-family: Arial, sans-serif;
}

.ast-tree-root,
.ast-children {
  list-style: none;
  margin: 0;
  padding: 0;
}

.ast-tree-root {
  display: flex;
  justify-content: center;
  min-width: max-content;
}

.ast-tree-root > .ast-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ast-item {
  position: relative;
  padding: 18px 8px 0;
  text-align: center;
}

.ast-children {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  position: relative;
  padding-top: 18px;
}

.ast-children::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  height: 18px;
  border-left: 2px solid #b8c5d8;
}

.ast-children > .ast-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  height: 18px;
  border-left: 2px solid #b8c5d8;
}

.ast-children > .ast-item:not(:only-child)::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  border-top: 2px solid #b8c5d8;
}

.ast-children > .ast-item:first-child:not(:only-child)::after {
  left: 50%;
}

.ast-children > .ast-item:last-child:not(:only-child)::after {
  right: 50%;
}

.ast-node {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 36px;
  max-width: 190px;
  box-sizing: border-box;
  padding: 9px 13px;
  border: 1px solid #cbd5e1;
  border-radius: 9px;
  background: #fff;
  color: #24324a;
  font-family: "Consolas", monospace;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
  box-shadow: 0 2px 4px rgb(15 23 42 / 5%);
}

.ast-root {
  background: #312e81;
  border-color: #312e81;
  color: #fff;
  font-size: 14px;
  padding: 12px 22px;
}

.ast-clause {
  background: #dbeafe;
  border-color: #93c5fd;
  color: #1e40af;
}

.ast-branch {
  background: #f1f5f9;
  border-color: #cbd5e1;
  color: #334155;
}

.ast-leaf {
  background: #dcfce7;
  border-color: #86efac;
  color: #166534;
}

@media (max-width: 700px) {
  #ast-area.ast-tree {
    padding: 20px 12px;
    max-height: 520px;
  }

  .ast-item {
    padding-left: 4px;
    padding-right: 4px;
  }

  .ast-node {
    padding: 7px 9px;
    font-size: 11px;
  }
}


/* Zero-setup imported-data workspace */
.import-panel{margin-bottom:17px}.import-dropzone{margin:18px 18px 0;border:2px dashed #c8d2e7;border-radius:12px;background:linear-gradient(135deg,#fafbff,#f5f7ff);min-height:150px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;text-align:center;cursor:pointer;transition:border-color .15s,background .15s;outline:none}.import-dropzone:hover,.import-dropzone:focus,.import-dropzone.drag-over{border-color:#6678ec;background:#eef1ff}.import-dropzone strong{font-size:13px;color:#25304a}.import-dropzone p{font-size:11px;color:#8a94aa;margin:0}.import-dropzone p span{color:#5268e8;font-weight:700;text-decoration:underline}.import-icon{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:#e7eaff;color:#5268e8;font-size:24px}.import-feedback{margin:12px 18px;color:#718098;font-size:11px;line-height:1.6;overflow-wrap:anywhere}.import-feedback.import-error{color:#b84545;background:#fff0ef;padding:10px 12px;border-radius:7px}.import-schema{margin:0 18px 12px;border:1px solid #e4e9f3;border-radius:9px;overflow:hidden}.import-schema-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#f8f9fd;padding:11px 13px;font-size:11px}.import-schema-heading span{color:#8b95aa;font-size:10px}.import-column-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0}.import-column-list>div{display:flex;justify-content:space-between;gap:10px;padding:9px 12px;border-top:1px solid #edf0f5;font-size:10px}.import-column-list code{font-family:'DM Mono',monospace;color:#44516d;overflow-wrap:anywhere}.import-column-list span{color:#7e8a9f}.import-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:0 18px 17px}.import-mode-note{font-size:10px;color:#8b95aa}.hidden{display:none!important}@media(max-width:720px){.import-dropzone{margin:14px 14px 0;padding:16px}.import-schema-heading{align-items:flex-start;flex-direction:column}.import-actions{padding:0 14px 14px}}


/* =========================================================
   SQLXPERT — DARK THEME OVERRIDES
   Keep this block at the END of static/style.css
   ========================================================= */

:root {
    color-scheme: dark;

    --bg: #0b1120;
    --surface: #111a2b;
    --surface-raised: #172337;
    --surface-hover: #202e44;
    --border: #2a3950;

    --text: #e5edf7;
    --text-muted: #98a9bf;

    --accent: #60a5fa;
    --accent-hover: #93c5fd;
    --accent-soft: #1b3453;

    --success: #4ade80;
    --danger: #f87171;
    --warning: #fbbf24;
}

/* Main page */
html {
    background: var(--bg) !important;
    color-scheme: dark;
}

body {
    background: var(--bg) !important;
    color: var(--text) !important;
}

/* Main application surfaces */
.app-shell,
main,
.main-content,
.content,
.workspace,
.page-content {
    background: var(--bg) !important;
    color: var(--text) !important;
}

/* Sidebar */
aside,
.sidebar {
    background: #0d1626 !important;
    color: var(--text) !important;
    border-color: var(--border) !important;
}

.sidebar a,
.sidebar button,
.sidebar label {
    color: var(--text-muted);
}

.sidebar a:hover,
.sidebar button:hover {
    color: var(--text) !important;
    background: var(--surface-hover) !important;
}

/* Cards, panels and sections */
.card,
.panel,
.stat-card,
.workspace-card,
.section,
.editor-panel,
.result-panel,
.schema-panel,
.history-panel,
.challenge-panel,
.compiler-panel,
.modal-content {
    background: var(--surface) !important;
    color: var(--text) !important;
    border-color: var(--border) !important;
    box-shadow: none;
}

/* Headings */
h1, h2, h3, h4, h5, h6,
.section-title,
.panel-title,
.card-title {
    color: var(--text) !important;
}

p,
label,
small,
.helper-text,
.description,
.muted {
    color: var(--text-muted);
}

/* SQL editor and all form controls */
input,
textarea,
select,
button,
[contenteditable="true"] {
    font: inherit;
}

input,
textarea,
select,
#sql-editor,
#insert-row-values {
    background: #0b1423 !important;
    color: var(--text) !important;
    border: 1px solid var(--border) !important;
    border-radius: 8px;
}

input::placeholder,
textarea::placeholder {
    color: #71839b !important;
    opacity: 1;
}

input:focus,
textarea:focus,
select:focus,
#sql-editor:focus {
    outline: none;
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 2px rgb(96 165 250 / 16%);
}

#sql-editor {
    font-family: "DM Mono", monospace;
    line-height: 1.7;
}

/* Buttons */
button,
.button,
.btn {
    background: var(--surface-raised);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: background 0.15s ease, border-color 0.15s ease;
}

button:hover,
.button:hover,
.btn:hover {
    background: var(--surface-hover);
    border-color: #506580;
}

/* Primary actions */
button.primary,
.btn-primary,
.button-primary,
#run-query,
#run-btn,
#execute-btn {
    background: #2563eb !important;
    color: #ffffff !important;
    border-color: #3b82f6 !important;
}

button.primary:hover,
.btn-primary:hover,
.button-primary:hover,
#run-query:hover,
#run-btn:hover,
#execute-btn:hover {
    background: #1d4ed8 !important;
}

/* Links */
a {
    color: var(--accent);
}

a:hover {
    color: var(--accent-hover);
}

/* Tables and query results */
table {
    width: 100%;
    border-collapse: collapse;
    color: var(--text);
}

th,
td {
    border-color: var(--border) !important;
}

th {
    background: var(--surface-raised) !important;
    color: #cbd9ea !important;
}

td {
    background: var(--surface) !important;
    color: var(--text) !important;
}

tr:hover td {
    background: var(--surface-hover) !important;
}

/* Code, tokens and compiler output */
code,
pre,
.code-block,
.token-list,
.ast-container,
.diagnostic,
.output,
.query-output {
    background: #0b1423;
    color: var(--text);
    border-color: var(--border);
}

.ast-node {
    background: var(--surface-raised) !important;
    color: var(--text) !important;
    border-color: #40536d !important;
}

/* Dividers and separators */
hr,
.divider,
.separator {
    border-color: var(--border) !important;
}

/* Status messages */
.success,
.status-success {
    color: var(--success) !important;
}

.error,
.status-error {
    color: var(--danger) !important;
}

.warning,
.status-warning {
    color: var(--warning) !important;
}

/* Scrollbars */
* {
    scrollbar-color: #40536a #111a2b;
    scrollbar-width: thin;
}

*::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

*::-webkit-scrollbar-track {
    background: #111a2b;
}

*::-webkit-scrollbar-thumb {
    background: #40536a;
    border-radius: 8px;
}

*::-webkit-scrollbar-thumb:hover {
    background: #60758f;
}

/* Independently scrollable schema contents */
.schema-scroll-area {
    max-height: 320px;
    overflow-y: auto;
    overflow-x: auto;
    overscroll-behavior: contain;
    padding-right: 6px;
}

/* Keep schema headings visible while scrolling the contents */
.schema-scroll-area table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
}

/* Existing utility class */
.hidden {
    display: none !important;
}

/* Selection highlight */
::selection {
    background: #294b75;
    color: #ffffff;
}


/* Scrollable database schema */
#schema-list {
    max-height: 320px;
    overflow-y: auto;
    overflow-x: auto;
    overscroll-behavior: contain;
    padding-right: 8px;
    scrollbar-width: thin;
    scrollbar-color: #475569 #111827;
}

#schema-list::-webkit-scrollbar {
    width: 7px;
}

#schema-list::-webkit-scrollbar-track {
    background: #111827;
    border-radius: 8px;
}

#schema-list::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 8px;
}

#schema-list::-webkit-scrollbar-thumb:hover {
    background: #64748b;
}
